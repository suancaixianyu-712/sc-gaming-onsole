<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <OutputType>Library</OutputType>
        <RootNamespace>Game</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>GameConsoleMod</AssemblyName>
        <Deterministic>true</Deterministic>
        <LangVersion>preview</LangVersion>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <Nullable>disable</Nullable>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <ErrorReport>prompt</ErrorReport>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DebugType>pdbonly</DebugType>
        <OutputPath>bin\Debug\</OutputPath>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DebugType>none</DebugType>
        <OutputPath>bin\Release\</OutputPath>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="SurvivalcraftAPI.Survivalcraft" Version="1.9.3" />
        <PackageReference Include="LiteNetLib" Version="2.1.4" GeneratePathProperty="true" />
    </ItemGroup>
    <ItemGroup>
        <None Update="modinfo.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Assets\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="PSPBlock.cs" />
        <Compile Include="GameConsoleModLoader.cs" />
        <Compile Include="SubsystemGameConsoleBlockBehavior.cs" />
        <Compile Include="PSPConsoleControls.cs" />
        <Compile Include="PSPConsoleState.cs" />
        <Compile Include="PSPConsoleOnlineState.cs" />
        <Compile Include="PSPConsoleProgress.cs" />
        <Compile Include="PSPPaddleGame.cs" />
        <Compile Include="PSPTetrisGame.cs" />
        <Compile Include="PSPOnlinePongGame.cs" />
        <Compile Include="PSPPongMenuWidget.cs" />
        <Compile Include="PSPConsoleModelWidget.cs" />
        <Compile Include="PSPConsoleJoystickWidget.cs" />
        <Compile Include="PSPConsoleDialog.cs" />
        <Compile Include="PSPConsolePainter.cs" />
        <Compile Include="PSPConsoleSceneWidget.cs" />
        <Compile Include="PSPConsoleScreenWidget.cs" />
        <Compile Include="PSPConsoleInputGuard.cs" />
        <Compile Include="Networking/Shared/*.cs" />
        <Compile Include="Networking/GameConsoleClient.cs" />
    </ItemGroup>
    <Target Name="CopyNetworkLibrary" BeforeTargets="PostBuild">
        <Copy SourceFiles="$(PkgLiteNetLib)/lib/net8.0/LiteNetLib.dll" DestinationFolder="$(TargetDir)" />
        <Copy SourceFiles="Networking/THIRD-PARTY-NOTICES.md" DestinationFolder="$(TargetDir)" />
    </Target>
    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <PropertyGroup>
            <PathOfScmod>$(MSBuildProjectDirectory)/$(AssemblyName).scmod</PathOfScmod>
        </PropertyGroup>
        <ZipDirectory SourceDirectory="$(TargetDir)" DestinationFile="$(PathOfScmod)" Overwrite="true" />
        <Message Text="The scmod file has been created: $(PathOfScmod)" Importance="high" />
    </Target>
</Project>
