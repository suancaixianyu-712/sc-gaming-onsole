<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>GameConsoleServer</AssemblyName>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="LiteNetLib" Version="2.1.4" />
        <Compile Include="../Networking/Shared/*.cs" Link="Protocol/%(Filename)%(Extension)" />
        <None Update="server-settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <None Update="README.md" CopyToPublishDirectory="PreserveNewest" />
        <None Include="../Networking/PROTOCOL.md" Link="PROTOCOL.md" CopyToPublishDirectory="PreserveNewest" />
        <None Include="../Networking/CLIENT.md" Link="CLIENT.md" CopyToPublishDirectory="PreserveNewest" />
        <None Include="../Networking/PONG-SYNC.md" Link="PONG-SYNC.md" CopyToPublishDirectory="PreserveNewest" />
        <None Include="../Networking/THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
